
# City Map Studio environment configuration

APP_ENV=development

# Optional persistent storage directory
# MAP_DATA_DIR=/var/data

# Browser origins allowed by the API
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Maximum queued and running jobs
MAX_JOBS=20

# Timeouts in seconds
JOB_TIMEOUT=1200
OVERPASS_TIMEOUT=300

# Optional local regional OpenStreetMap extract. Leave unset for Overpass.
# OSM_EXTRACT_FILE=C:\\MapData\\massachusetts-latest.osm.pbf
